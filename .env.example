# SurveyOps Environment Configuration
APP_NAME=SurveyOps
APP_ENV=development
LOG_LEVEL=INFO

# Database (PostgreSQL)
POSTGRES_USER=surveyops
POSTGRES_PASSWORD=surveyops_secure_pass
POSTGRES_DB=surveyops
POSTGRES_HOST_PORT=5472
DATABASE_URL=postgresql+psycopg://surveyops:surveyops_secure_pass@localhost:5472/surveyops

# Redis & Celery
REDIS_HOST_PORT=6382
REDIS_URL=redis://localhost:6382/0
CELERY_BROKER_URL=redis://localhost:6382/0
CELERY_RESULT_BACKEND=redis://localhost:6382/1
PIPELINE_EAGER_MODE=false

# API & Security
API_HOST_PORT=8070
FRONTEND_HOST_PORT=3070
SECRET_KEY=surveyops-dev-secret-key-change-in-production-32chars
ACCESS_TOKEN_EXPIRE_MINUTES=720
CORS_ORIGINS=http://localhost:3070,http://localhost:5174,http://127.0.0.1:3070,http://127.0.0.1:5174

# Pipeline Quality Thresholds
QUALITY_AUTO_APPROVE_THRESHOLD=88.0
QUALITY_REJECT_THRESHOLD=45.0
DUPLICATE_WINDOW_MINUTES=60
MIN_COMPLETION_SECONDS_PER_QUESTION=3.0

# Frontend
VITE_API_BASE_URL=http://localhost:8070/api/v1
